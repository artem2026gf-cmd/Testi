-- A-mod menu | ЧАСТЬ 2/5: шапка, перетаскивание, открытие/закрытие, длинная линия, уголок изменения размера
local M = _G.AmodM
if not M then
	warn("[A-mod] Сначала запусти ЧАСТЬ 1")
else
M.run(function()
	local Players = game:GetService("Players")
	local TweenService = game:GetService("TweenService")
	local UserInputService = game:GetService("UserInputService")
	local C, new, tw, bind = M.C, M.new, M.tw, M.bind
	local W, H, HEADER_H = M.W, M.H, M.HEADER_H
	local gui, root, window, rootScale, veil = M.gui, M.root, M.window, M.rootScale, M.veil
	if not (gui and window) then error("Сначала запусти часть 1") end

	local header = new("Frame", {
		Name = "Header",
		Size = UDim2.fromOffset(W, HEADER_H),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
	}, window)
	new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(21, 28, 44)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(15, 18, 23)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 18, 23)),
		}),
	}, header)
	new("Frame", {
		Position = UDim2.fromOffset(0, HEADER_H - 1),
		Size = UDim2.fromOffset(W, 1),
		BackgroundColor3 = C.sideEdge,
		BorderSizePixel = 0,
	}, header)
	M.header = header

	local accentBar = new("Frame", {
		Size = UDim2.fromOffset(3, HEADER_H),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
	}, header)
	local accentGradient = new("UIGradient", {
		Rotation = 90,
		Offset = Vector2.new(0, -0.45),
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(66, 104, 192)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(128, 168, 250)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(66, 104, 192)),
		}),
	}, accentBar)
	local accentLoop = TweenService:Create(accentGradient, TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Offset = Vector2.new(0, 0.45),
	})
	accentLoop:Play()
	M.loops[#M.loops + 1] = accentLoop

	new("TextLabel", {
		Name = "Title",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(13, 18),
		Size = UDim2.fromOffset(220, 20),
		BackgroundTransparency = 1,
		Text = "A-mod",
		Font = M.FONT,
		TextSize = 17,
		TextColor3 = C.title,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, header)
	new("TextLabel", {
		Name = "Subtitle",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(13, 36),
		Size = UDim2.fromOffset(220, 18),
		BackgroundTransparency = 1,
		Text = "ROBLOX",
		Font = M.FONT,
		TextSize = 15,
		TextColor3 = C.subtitle,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, header)

	new("TextLabel", {
		Name = "Online",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromOffset(W - 11, 21),
		Size = UDim2.fromOffset(56, 18),
		BackgroundTransparency = 1,
		Text = "ONLINE",
		Font = M.FONT,
		TextSize = 15,
		TextColor3 = C.online,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, header)
	new("TextLabel", {
		Name = "Version",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromOffset(W - 11, 38),
		Size = UDim2.fromOffset(120, 16),
		BackgroundTransparency = 1,
		Text = "v3.0 - BETA",
		Font = M.FONT,
		TextSize = 12,
		TextColor3 = C.version,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, header)
	local dotX = W - 11 - 56 - 8
	local ring = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(dotX, 21),
		Size = UDim2.fromOffset(7, 7),
		BackgroundColor3 = C.online,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
	}, header)
	M.corner(ring, 99)
	local ringLoop = TweenService:Create(ring, TweenInfo.new(1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1), {
		Size = UDim2.fromOffset(22, 22),
		BackgroundTransparency = 1,
	})
	ringLoop:Play()
	M.loops[#M.loops + 1] = ringLoop
	local dot = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(dotX, 21),
		Size = UDim2.fromOffset(7, 7),
		BackgroundColor3 = C.online,
		BorderSizePixel = 0,
	}, header)
	M.corner(dot, 99)

	-- Перетаскивание окна за шапку
	local dragging = false
	local dragStart, startPos
	bind(header.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = root.Position
		end
	end)
	bind(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			root.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
	bind(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	-- Подгон размера окна под экран (ручной размер имеет приоритет)
	M.fitScale = 1
	M.isOpen = false
	function M.curScale()
		return M.manualScale or M.fitScale
	end

	function M.refit()
		local camera = workspace.CurrentCamera
		if not camera then return end
		local view = camera.ViewportSize
		M.fitScale = math.clamp(math.min(view.X * 0.96 / W, view.Y * 0.9 / H), 0.5, 1.6)
		if M.isOpen then
			rootScale.Scale = M.curScale()
		end
	end

	-- Открытие и закрытие (бесконечные анимации шапки на паузе, пока меню закрыто)
	function M.setOpen(open)
		M.isOpen = open
		local scale = M.curScale()
		for _, loop in ipairs(M.loops) do
			if open then loop:Play() else task.delay(0.3, function() if not M.isOpen then loop:Pause() end end) end
		end
		if open then
			root.Visible = true
			rootScale.Scale = scale * 0.92
			veil.BackgroundTransparency = 0
			tw(veil, 0.4, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
			tw(rootScale, 0.5, { Scale = scale }, Enum.EasingStyle.Quint)
			tw(M.edgeStroke, 0.4, { Transparency = 0.1 }, Enum.EasingStyle.Quad)
			for _, shadow in ipairs(M.shadows) do
				shadow.obj.BackgroundTransparency = 1
				tw(shadow.obj, 0.5, { BackgroundTransparency = shadow.base }, Enum.EasingStyle.Quad)
			end
		else
			tw(veil, 0.22, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quad)
			tw(rootScale, 0.25, { Scale = scale * 0.94 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tw(M.edgeStroke, 0.25, { Transparency = 1 }, Enum.EasingStyle.Quad)
			for _, shadow in ipairs(M.shadows) do
				tw(shadow.obj, 0.25, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
			end
			task.delay(0.28, function()
				if not M.isOpen then
					root.Visible = false
				end
			end)
		end
	end

	function M.toggle()
		M.setOpen(not M.isOpen)
	end

	-- Линия снизу экрана по центру: нажми, чтобы открыть или закрыть меню
	local handle = new("TextButton", {
		Name = "Handle",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -3),
		Size = UDim2.fromOffset(220, 28),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 50,
	}, gui)
	local handleLine = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(120, 4),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
	}, handle)
	M.corner(handleLine, 99)
	bind(handle.MouseEnter, function()
		tw(handleLine, 0.2, { Size = UDim2.fromOffset(160, 4), BackgroundTransparency = 0.15 })
	end)
	bind(handle.MouseLeave, function()
		tw(handleLine, 0.25, { Size = UDim2.fromOffset(120, 4), BackgroundTransparency = 0.5 })
	end)
	bind(handle.Activated, function()
		M.toggle()
	end)

	-- Клавиша K тоже открывает и закрывает
	bind(UserInputService.InputBegan, function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.K then
			M.toggle()
		end
	end)

	-- ===== Уголок справа внизу: тянешь, чтобы менять размер меню вручную =====
	local grip = new("TextButton", {
		Name = "ResizeGrip",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -3, 1, -3),
		Size = UDim2.fromOffset(34, 34),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 60,
	}, root)
	local gripBg = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = C.tabSel,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		ZIndex = 60,
	}, grip)
	M.corner(gripBg, 99)
	local gripStroke = M.stroke(gripBg, C.accent, 1, 0.55)
	local gripIcon = M.icon(gripBg, "resize", C.tabOn, 12)
	for _, part in ipairs(gripIcon.holder:GetDescendants()) do
		if part:IsA("GuiObject") then part.ZIndex = 61 end
	end
	M.gripIcon = gripIcon

	local resizing = false
	local rStart, rStartScale, rStartPos
	local lastTap = 0
	bind(grip.MouseEnter, function()
		tw(gripBg, 0.18, { Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 0 })
		tw(gripStroke, 0.18, { Transparency = 0.1 })
	end)
	bind(grip.MouseLeave, function()
		if not resizing then
			tw(gripBg, 0.22, { Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 0.1 })
			tw(gripStroke, 0.22, { Transparency = 0.55 })
		end
	end)
	bind(grip.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			rStart = input.Position
			rStartScale = rootScale.Scale
			rStartPos = root.Position
			tw(gripBg, 0.15, { Size = UDim2.fromOffset(28, 28) }, Enum.EasingStyle.Back)
			tw(gripStroke, 0.15, { Transparency = 0 })
			-- двойное касание: вернуть размер по умолчанию
			if os.clock() - lastTap < 0.35 then
				resizing = false
				M.manualScale = nil
				M.refit()
				tw(rootScale, 0.3, { Scale = M.fitScale }, Enum.EasingStyle.Back)
				if M.toast then M.toast("Size reset") end
			end
			lastTap = os.clock()
		end
	end)
	bind(UserInputService.InputChanged, function(input)
		if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - rStart
			-- по диагонали: ширина и высота растут вместе
			local grow = (delta.X + delta.Y * (W / H)) / 2
			local wanted = (W * rStartScale + grow) / W
			local newScale = math.clamp(wanted, 0.45, math.max(M.fitScale * 1.6, 1))
			M.manualScale = newScale
			rootScale.Scale = newScale
			-- верхний левый угол остаётся на месте, угол тянется за пальцем
			local diff = newScale - rStartScale
			root.Position = UDim2.new(
				rStartPos.X.Scale, rStartPos.X.Offset + W * diff / 2,
				rStartPos.Y.Scale, rStartPos.Y.Offset + H * diff / 2
			)
		end
	end)
	bind(UserInputService.InputEnded, function(input)
		if resizing and (input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch) then
			resizing = false
			tw(gripBg, 0.22, { Size = UDim2.fromOffset(22, 22) }, Enum.EasingStyle.Back)
			tw(gripStroke, 0.22, { Transparency = 0.55 })
		end
	end)

	M.refit()
end)

end
-- A-mod menu | ЧАСТЬ 3/5: боковая панель с иконками и эффект вкладки
local M = _G.AmodM
if not M then
	warn("[A-mod] Сначала запусти ЧАСТЬ 1")
else
	M.run(function()
		local C, new, corner, tw, bind = M.C, M.new, M.corner, M.tw, M.bind
		local window = M.window
		local HEADER_H, SIDE_W, CW, CH = M.HEADER_H, M.SIDE_W, M.CW, M.CH

		local TAB_NAMES = { "Combat", "Players", "Visuals", "Misc", "Skins", "Colors", "Settings" }
		local TAB_ICONS = { "sword", "users", "eye", "grid", "gem", "palette", "sliders" }
		local TAB_W, TAB_H, TAB_PITCH, TAB_TOP = 49, 48, 49, 2
		M.TAB_NAMES = TAB_NAMES

		local function tabTop(index)
			return TAB_TOP + (index - 1) * TAB_PITCH
		end

		local sidebar = new("Frame", {
			Name = "Sidebar",
			Position = UDim2.fromOffset(0, HEADER_H),
			Size = UDim2.fromOffset(SIDE_W, CH),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BorderSizePixel = 0,
		}, window)
		new("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Color3.fromRGB(20, 25, 36), Color3.fromRGB(16, 20, 29)),
		}, sidebar)
		new("Frame", {
			Name = "Edge",
			Position = UDim2.fromOffset(SIDE_W - 1, 0),
			Size = UDim2.fromOffset(1, CH),
			BackgroundColor3 = C.sideEdge,
			BorderSizePixel = 0,
		}, sidebar)
		M.sidebar = sidebar

		-- Фон при наведении (под подсветкой и под иконками)
		local hoverFrames = {}
		for index = 1, #TAB_NAMES do
			local hover = new("Frame", {
				Name = "Hover" .. index,
				Position = UDim2.fromOffset(2, tabTop(index)),
				Size = UDim2.fromOffset(TAB_W, TAB_H),
				BackgroundColor3 = C.tabHover,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
			}, sidebar)
			corner(hover, 2)
			hoverFrames[index] = hover
		end

		-- Подсветка выбранной вкладки: заливка-градиент, тонкая рамка, свечение и яркая линия слева
		local highlight = new("Frame", {
			Name = "Highlight",
			Position = UDim2.fromOffset(2, tabTop(4)),
			Size = UDim2.fromOffset(TAB_W, TAB_H),
			BackgroundColor3 = C.tabSel,
			BorderSizePixel = 0,
		}, sidebar)
		corner(highlight, 3)
		highlight.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(34, 44, 76)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(23, 28, 46)),
			}),
		}, highlight)
		local hlStroke = M.stroke(highlight, C.accent, 1, 0.82)
		local glow = new("Frame", {
			Name = "Glow",
			Size = UDim2.fromOffset(22, TAB_H),
			BackgroundColor3 = C.accent,
			BackgroundTransparency = 0.7,
			BorderSizePixel = 0,
		}, highlight)
		new("UIGradient", {
			Transparency = NumberSequence.new(0, 1),
		}, glow)
		local bar = new("Frame", {
			Name = "Bar",
			Size = UDim2.fromOffset(3, TAB_H),
			BackgroundColor3 = Color3.fromRGB(110, 158, 252),
			BorderSizePixel = 0,
		}, highlight)
		corner(bar, 2)
		M.hlStroke = hlStroke
		M.highlight = highlight

		-- Кнопки вкладок с иконками
		M.tabButtons = {}
		M.tabIcons = {}
		M.currentTab = nil

		for index, name in ipairs(TAB_NAMES) do
			local button = new("TextButton", {
				Name = "Tab" .. index,
				Position = UDim2.fromOffset(2, tabTop(index)),
				Size = UDim2.fromOffset(TAB_W, TAB_H),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
			}, sidebar)
			local icon = M.icon(button, TAB_ICONS[index], C.tabOff, 22)
			icon.holder.Position = UDim2.fromScale(0.5, 0.5)
			M.tabIcons[index] = icon
			local scale = new("UIScale", { Scale = 1 }, button)
			M.tabButtons[index] = button

			bind(button.MouseEnter, function()
				tw(hoverFrames[index], 0.18, { BackgroundTransparency = 0.35 }, Enum.EasingStyle.Quad)
				if M.currentTab ~= index then
					M.tint(M.tabIcons[index], Color3.fromRGB(130, 146, 210), 0.18)
					tw(M.tabIcons[index].scale, 0.18, { Scale = 1.08 }, Enum.EasingStyle.Quad)
				end
			end)
			bind(button.MouseLeave, function()
				tw(hoverFrames[index], 0.22, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
				if M.currentTab ~= index then
					M.tint(M.tabIcons[index], C.tabOff, 0.22)
					tw(M.tabIcons[index].scale, 0.22, { Scale = 1 }, Enum.EasingStyle.Quad)
				end
				tw(scale, 0.12, { Scale = 1 }, Enum.EasingStyle.Quad)
			end)
			bind(button.MouseButton1Down, function()
				tw(scale, 0.1, { Scale = 0.92 }, Enum.EasingStyle.Quad)
			end)
			bind(button.MouseButton1Up, function()
				tw(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
			end)
			bind(button.Activated, function()
				M.selectTab(index)
			end)
		end

		-- Выбор вкладки: подсветка переезжает, иконки меняют цвет и размер
		function M.selectTab(index, instant)
			if M.currentTab == index then return end
			M.currentTab = index
			local target = UDim2.fromOffset(2, tabTop(index))
			if instant then
				highlight.Position = target
			else
				tw(highlight, 0.34, { Position = target }, Enum.EasingStyle.Quint)
			end
			for i, iconObj in ipairs(M.tabIcons) do
				local color = (i == index) and C.tabOn or C.tabOff
				local size = (i == index) and 1.12 or 1
				if instant then
					M.tint(iconObj, color)
					iconObj.scale.Scale = size
				else
					M.tint(iconObj, color, 0.25)
					tw(iconObj.scale, 0.3, { Scale = size }, Enum.EasingStyle.Back)
				end
			end
			if M.onTabSelected then
				M.onTabSelected(index)
			end
		end

		local pagesFrame = new("Frame", {
			Name = "Content",
			Position = UDim2.fromOffset(SIDE_W, HEADER_H),
			Size = UDim2.fromOffset(CW, CH),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
		}, window)
		M.pagesFrame = pagesFrame
	end)
end
