-- Иконка из гладких примитивов. Все позиции и размеры в долях (Scale),
-- поэтому нет округления до пикселей и "ломаных" линий.
function M.icon(parent, name, color, size)
	local holder = new("Frame", {
		Name = "Icon_" .. name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
	}, parent)
	local G = 24
	local k = size / G
	local items = {}

	local function fillItem(obj)
		items[#items + 1] = { obj = obj, kind = "fill" }
	end
	local function strokeItem(stroke)
		items[#items + 1] = { obj = stroke, kind = "stroke" }
	end
	local function pill(obj)
		new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, obj)
	end
	local function minThickness(w)
		return math.max(w * k, 1.3)
	end

	for _, op in ipairs(M.ICONS[name]) do
		local kind = op[1]
		if kind == "bar" then
			local x1, y1, x2, y2, w = op[2], op[3], op[4], op[5], op[6]
			local cx, cy = (x1 + x2) / 2, (y1 + y2) / 2
			local sx, sy, rot
			if math.abs(y2 - y1) < 0.01 then
				sx, sy, rot = math.abs(x2 - x1) + w, w, 0
			elseif math.abs(x2 - x1) < 0.01 then
				sx, sy, rot = w, math.abs(y2 - y1) + w, 0
			else
				local dx, dy = x2 - x1, y2 - y1
				sx, sy, rot = math.sqrt(dx * dx + dy * dy) + w, w, math.deg(math.atan2(dy, dx))
			end
			local bar = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(cx / G, cy / G),
				Size = UDim2.fromScale(sx / G, sy / G),
				Rotation = rot,
				BackgroundColor3 = color,
				BorderSizePixel = 0,
			}, holder)
			pill(bar)
			fillItem(bar)
		elseif kind == "dot" then
			local cx, cy, r = op[2], op[3], op[4]
			local dot = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(cx / G, cy / G),
				Size = UDim2.fromScale(2 * r / G, 2 * r / G),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
			}, holder)
			pill(dot)
			fillItem(dot)
		elseif kind == "ring" then
			local cx, cy, r, w = op[2], op[3], op[4], op[5]
			local thick = minThickness(w)
			local box = holder
			local ox, oy = 0, 0
			if op[6] then
				-- кольцо обрезается прямоугольником (получается дуга)
				box = new("Frame", {
					Position = UDim2.fromScale(op[6] / G, op[7] / G),
					Size = UDim2.fromScale(op[8] / G, op[9] / G),
					BackgroundTransparency = 1,
					ClipsDescendants = true,
				}, holder)
				ox, oy = op[6], op[7]
			end
			local frameRadius = r - (thick / k) / 2
			local ringFrame = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
			}, box)
			if op[6] then
				ringFrame.Position = UDim2.fromScale((cx - ox) / op[8], (cy - oy) / op[9])
				ringFrame.Size = UDim2.fromScale(2 * frameRadius / op[8], 2 * frameRadius / op[9])
			else
				ringFrame.Position = UDim2.fromScale(cx / G, cy / G)
				ringFrame.Size = UDim2.fromScale(2 * frameRadius / G, 2 * frameRadius / G)
			end
			pill(ringFrame)
			strokeItem(new("UIStroke", { Color = color, Thickness = thick }, ringFrame))
		elseif kind == "rrect" then
			local x, y, w, h, rad, sw, rot = op[2], op[3], op[4], op[5], op[6], op[7], op[8]
			local thick = minThickness(sw)
			local inner = thick / k
			local rect = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale((x + w / 2) / G, (y + h / 2) / G),
				Size = UDim2.fromScale((w - inner) / G, (h - inner) / G),
				Rotation = rot or 0,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
			}, holder)
			new("UICorner", { CornerRadius = UDim.new(math.min(rad / math.min(w, h), 0.5), 0) }, rect)
			strokeItem(new("UIStroke", { Color = color, Thickness = thick }, rect))
		end
	end

	local scale = new("UIScale", { Scale = 1 }, holder)
	return { holder = holder, items = items, scale = scale }
end

function M.tint(iconObj, color, duration)
	for _, item in ipairs(iconObj.items) do
		local props = item.kind == "fill" and { BackgroundColor3 = color } or { Color = color }
		if duration and duration > 0 then
			tw(item.obj, duration, props, Enum.EasingStyle.Quad)
		else
			for key, value in pairs(props) do
				item.obj[key] = value
			end
		end
	end
end

-- Куда класть интерфейс
local parentGui
local okHui, hui = pcall(function() return gethui and gethui() end)
if okHui and hui then
	parentGui = hui
else
	local okCore, core = pcall(function() return game:GetService("CoreGui") end)
	if okCore and core then
		parentGui = core
	else
		parentGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	end
end
M.parentGui = parentGui

function M.fail(message)
	warn("[A-mod] " .. tostring(message))
	pcall(function()
		local errGui = Instance.new("ScreenGui")
		errGui.Name = "AmodErr"
		errGui.ResetOnSpawn = false
		errGui.DisplayOrder = 2000
		errGui.Parent = parentGui
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(0.92, 0, 0, 150)
		label.Position = UDim2.new(0.04, 0, 0, 10)
		label.BackgroundColor3 = Color3.fromRGB(40, 12, 14)
		label.TextColor3 = Color3.fromRGB(255, 120, 120)
		label.TextWrapped = true
		label.TextSize = 12
		label.Font = Enum.Font.Code
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextYAlignment = Enum.TextYAlignment.Top
		label.Text = "A-mod, ошибка:\n" .. tostring(message)
		label.Parent = errGui
		task.delay(40, function() errGui:Destroy() end)
	end)
end

function M.run(fn)
	local ok, err = xpcall(fn, function(e)
		return tostring(e) .. "\n" .. debug.traceback()
	end)
	if not ok then
		M.fail(err)
	end
	return ok
end

function M.destroy()
	for _, connection in ipairs(M.connections) do
		pcall(function() connection:Disconnect() end)
	end
	if M.gui then
		M.gui:Destroy()
	end
	_G.AmodM = nil
end

